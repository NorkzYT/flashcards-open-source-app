# TEST ONLY (compose.ai-test.yml): the synthetic AI provider, baked in with a fixed mode instead of
# bind-mounted, so the non-root node user can read it whatever umask the checkout was made under.
FROM node:24.22.3-alpine
# COPY --chmod also sets the mode of a parent directory it creates, so create /selfhost first.
RUN install -d -m 0755 /selfhost
COPY --chmod=0444 ai-test-provider.mjs /selfhost/ai-test-provider.mjs
USER node
CMD ["node", "/selfhost/ai-test-provider.mjs"]
