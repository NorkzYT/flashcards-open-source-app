# Nibomo standalone instance settings. setup.sh copies this to <instance>/.env once and never
# overwrites it. No value here is a secret: credentials live in <instance>/secrets/.
# Docs: docs/self-hosting.md

# Absolute path of the deployment directory that holds this .env and secrets/.
NIBOMO_INSTANCE_DIR=/opt/docker/containers/nibomo
# Compose project; its name prefixes every volume. Keep `nibomo` for the real deployment and use a
# different name for every test or restore instance.
NIBOMO_COMPOSE_PROJECT=nibomo
# Docker endpoint every script uses (a local Unix socket; TCP/remote endpoints are refused). A shell
# DOCKER_HOST that differs from it is refused, never silently used.
NIBOMO_DOCKER_HOST=unix:///var/run/docker.sock
# Image tag for locally built images; use the tested commit, e.g. `git -C sourc rev-parse --short=12 HEAD`.
NIBOMO_IMAGE_TAG=replace-with-tested-commit

# Browser and native clients use app./api./auth. under one base domain, matching the Android
# custom-server derivation (https://<base> -> https://api.<base>/v1, https://auth.<base>).
NIBOMO_BASE_DOMAIN=study.example.com
NIBOMO_APP_HOST=app.study.example.com
NIBOMO_API_HOST=api.study.example.com
NIBOMO_AUTH_HOST=auth.study.example.com
# MCP for AI assistants: https://<NIBOMO_MCP_HOST>/mcp, which must be mcp.<base>.
NIBOMO_MCP_HOST=mcp.study.example.com
# Optional second public MCP host serving the same server (tokens are bound to the host they were
# issued for). Leave empty unless DNS/TLS also route it here.
NIBOMO_MCP_ALTERNATE_HOST=
# Browser origins allowed to call MCP (comma-separated exact https origins). Empty refuses every
# request that carries an Origin header; desktop and server-side MCP clients send none.
NIBOMO_MCP_ALLOWED_ORIGINS=
# Browser/phone-reachable origin of presigned media URLs (routed by the gateway to the private store).
NIBOMO_MEDIA_HOST=media.study.example.com
# Private RustFS bucket for images, attachments and exports (lowercase letters, digits, hyphens).
NIBOMO_MEDIA_BUCKET=nibomo-media

# Generated per instance by setup.sh (the token audience); keep it stable.
NIBOMO_LOCAL_AUTH_CLIENT_ID=generated-by-setup

# Who may create an account (comma-separated). Existing accounts can always sign in.
NIBOMO_ALLOWED_EMAILS=you@example.com
NIBOMO_ALLOWED_EMAIL_DOMAINS=
# Bootstrap administrators (comma-separated), applied by every migration run.
NIBOMO_ADMIN_EMAILS=

# SMTP for sign-in codes. TLS modes: starttls (required upgrade) or implicit (TLS from connect).
NIBOMO_SMTP_HOST=smtp.example.com
NIBOMO_SMTP_PORT=587
NIBOMO_SMTP_TLS_MODE=starttls
NIBOMO_SMTP_FROM=Nibomo <no-reply@study.example.com>
# Set when the server requires authentication; the password goes in secrets/smtp_password.
NIBOMO_SMTP_USER=

# Gateway listener. Keep loopback and put a TLS reverse proxy in front of it.
NIBOMO_GATEWAY_BIND=127.0.0.1
NIBOMO_GATEWAY_PORT=8088
# Peers allowed to supply X-Forwarded-For: the exact /32 your proxy arrives from inside the gateway
# container (for a host proxy, the <project>_edge bridge gateway; docs/self-hosting.md), not a range.
NIBOMO_GATEWAY_TRUSTED_PROXIES=private_ranges

# AI chat: `none` (chat answers AI_PROVIDER_NOT_CONFIGURED), `openai` (operator-funded; put the
# key in secrets/openai_api_key, never here), or `user-key` (no operator key: each person uses their own
# OpenAI key, always sealed as below; keyless turns answer OPENAI_API_KEY_REQUIRED_STANDALONE).
NIBOMO_AI_PROVIDER=none
# Personal (per-user) OpenAI keys with NIBOMO_AI_PROVIDER=openai: empty = refused; `sealed` = accepted,
# held only as ciphertext under secrets/chat_credential_key until the worker starts the run.
NIBOMO_AI_PERSONAL_KEYS=
# Generated by setup.sh; keep it stable. Changing it or secrets/chat_credential_key interrupts personal-key
# runs queued in the last 10 minutes.
NIBOMO_INSTANCE_ID=generated-by-setup
# Chat messages per person per UTC month on the operator's key (1-100000); unused with user-key.
NIBOMO_AI_MONTHLY_MESSAGES=100
